rules_version = '2';

// =============================================================================
// Reglas de seguridad de Cloud Firestore — Restaurante Manía
//
// Principios:
//   * El catálogo (categorías, platos, mesas, configuración) es público de
//     lectura: la web y los agentes de IA lo consumen sin autenticación.
//   * La escritura del catálogo exige rol de administrador.
//   * Cualquiera puede crear un pedido desde la web, pero el documento debe
//     cumplir el contrato de datos y nacer en estado `pending`.
//   * Los pedidos se leen por ID (URL no adivinable) o se listan solo con rol
//     de personal. Nunca se permite listar pedidos de forma anónima.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isStaff() {
      return role() in ['admin', 'cashier', 'waiter', 'cook'];
    }

    function canManageMenu() {
      return isAdmin();
    }

    function canManageTables() {
      return role() in ['admin', 'waiter', 'cashier'];
    }

    // ---------------------------------------------------------------------
    // Catálogo público
    // ---------------------------------------------------------------------

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if canManageMenu();
      allow delete: if canManageMenu();
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow create, update: if canManageMenu();
      allow delete: if canManageMenu();
    }

    match /restaurant/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tables/{tableId} {
      allow read: if true;
      allow write: if canManageTables();
    }

    // ---------------------------------------------------------------------
    // Usuarios y roles
    // ---------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Pedidos
    // ---------------------------------------------------------------------

    match /orders/{orderId} {
      // `get` por ID: el identificador de Firestore es un UUID no adivinable,
      // así la página de confirmación puede mostrar el pedido recién creado.
      allow get: if true;

      // Listar pedidos requiere ser personal del restaurante.
      allow list: if isStaff();

      allow create: if isValidOrder();

      allow update: if isStaff() && preservesIdentity();
      allow delete: if isAdmin();
    }

    // Contrato mínimo del pedido. Evita documentos basura o manipulados.
    function isValidOrder() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'code',
          'customerName',
          'customerPhone',
          'type',
          'items',
          'subtotal',
          'tax',
          'total',
          'status',
          'paymentStatus',
          'paymentMethod',
          'createdAt'
        ])
        && data.customerName is string
        && data.customerName.size() >= 2
        && data.customerName.size() <= 80
        && data.customerPhone is string
        && data.customerPhone.size() >= 7
        && data.customerPhone.size() <= 20
        && data.type in ['pickup', 'delivery', 'table']
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 50
        && data.subtotal is number
        && data.subtotal >= 0
        && data.tax is number
        && data.tax >= 0
        && data.total is number
        && data.total == data.subtotal + data.tax
        && data.status == 'pending'
        && data.paymentStatus == 'pending'
        && data.paymentMethod in ['cash', 'card', 'nequi', 'daviplata']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && (
          data.type != 'table'
          || (data.tableNumber is int && data.tableNumber >= 1 && data.tableNumber <= 100)
        );
    }

    // Un pedido no puede cambiar de dueño, código ni fecha de creación.
    function preservesIdentity() {
      let incoming = request.resource.data;
      let existing = resource.data;
      return incoming.code == existing.code
        && incoming.customerName == existing.customerName
        && incoming.createdAt == existing.createdAt;
    }

    // ---------------------------------------------------------------------
    // Métricas y reportes (solo escritura desde Cloud Functions)
    // ---------------------------------------------------------------------

    match /stats/{docId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /reports/{docId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Denegar todo lo no contemplado explícitamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
