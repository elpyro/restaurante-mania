.env
.env.local
.env.*.local
*.local
!.env.example
*.pem
*.key

# --- Logs y temporales ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.logs/
tmp/
temp/

# --- Cobertura de tests ---
coverage/
.nyc_output/
htmlcov/

# --- Sistema operativo ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
