*.keystore
*.aab
*.apk

# --- Firebase ---
.firebase/
firebase/functions/lib/
firebase/functions/node_modules/
firebase/.firebaserc
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
