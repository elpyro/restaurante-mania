# .env.example — Variables de entorno (copiar a web/.env.local)
#
# Sin Firebase configurado, la web funciona en MODO DEMO con datos semilla.
# Rellena los valores para conectar con un proyecto real.

# --- Firebase (Firestore REST en el servidor) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Solo servidor (Netlify/entorno local): cuenta de servicio con rol datastore.user.
# Se usa como JSON de una sola línea; nunca exponer al cliente.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- SEO / GEO ---
# Dominio público sin barra final. Se usa en metadata, sitemap y llms.txt.
# TODO: reemplazar por el dominio real de producción cuando exista
# (ej. https://tu-dominio.netlify.app). En Netlify configurar esta variable
# de entorno; sin dominio se usa el placeholder.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Datos del restaurante ---
NEXT_PUBLIC_RESTAURANT_NAME=Restaurante Manía
NEXT_PUBLIC_RESTAURANT_PHONE=+57 300 123 4567
NEXT_PUBLIC_RESTAURANT_WHATSAPP=573001234567
NEXT_PUBLIC_RESTAURANT_ADDRESS=Calle 10 # 43-12, Medellín
NEXT_PUBLIC_RESTAURANT_CITY=Medellín
NEXT_PUBLIC_RESTAURANT_HOURS=11:00 - 22:00
